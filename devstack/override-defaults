# Sourced by devstack before its own libraries, so these become the
# defaults for a stack that enables this plugin. local.conf still wins.
#
# DRBD is the transport under test. The plugin also provides the
# "linstoriscsi" backend type for anyone who wants it in local.conf.
CINDER_ENABLED_BACKENDS=${CINDER_ENABLED_BACKENDS:-linstordrbd:linstor-drbd-a,linstordrbd:linstor-drbd-b}
TEMPEST_VOLUME_VENDOR=${TEMPEST_VOLUME_VENDOR:-LINBIT}
TEMPEST_STORAGE_PROTOCOL=${TEMPEST_STORAGE_PROTOCOL:-DRBD}
TEMPEST_EXTEND_ATTACHED_VOLUME=${TEMPEST_EXTEND_ATTACHED_VOLUME:-True}
TEMPEST_VOLUME_MANAGE_VOLUME=${TEMPEST_VOLUME_MANAGE_VOLUME:-True}
TEMPEST_VOLUME_REVERT_TO_SNAPSHOT=${TEMPEST_VOLUME_REVERT_TO_SNAPSHOT:-True}
# A DRBD resource has one writer; the multiattach tests would fail by design.
ENABLE_VOLUME_MULTIATTACH=${ENABLE_VOLUME_MULTIATTACH:-False}
